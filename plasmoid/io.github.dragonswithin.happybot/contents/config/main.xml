<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>
  <group name="General">
    <!-- Which picture stands for the assistant on the panel and beside its
         replies. false (default): the system's wand icon (tools-wizard).
         true: Happy Bot's robot mascot (contents/images/happy-bot.svg). -->
    <entry name="useRobotMascot" type="Bool">
      <default>false</default>
    </entry>
    <!-- Address of the per-user daemon. Empty (default) means the loopback
         port derived from the user's uid: http://127.0.0.1:(19000 + uid - 1000).
         Set only to reach a daemon started on a non-default port. -->
    <entry name="daemonUrl" type="String">
      <default></default>
    </entry>
    <!-- What the panel shows. false (default): the assistant's icon, which
         opens a popup where the user types. true: a search bar (a text field
         in the panel) where the user types, with results in a popup above
         it. While the bar has keyboard focus Plasma draws its blue panel
         focus indicator, which a widget cannot switch off. Vertical panels
         always show the icon. -->
    <entry name="inputInPanel" type="Bool">
      <default>false</default>
    </entry>
    <!-- Width of the panel search bar, in Plasma grid units (one grid unit
         is about the height of a line of text). Default 18. Range 8 to 60.
         Used only when the panel shows the search bar. -->
    <entry name="barWidth" type="Int">
      <default>18</default>
      <min>8</min>
      <max>60</max>
    </entry>
    <!-- The floating Happy Bot, shown when Happy Bot runs as its own app
         (happy-bot-app; these values belong to that app's copy of the
         widget). floatingX, floatingY: its position in logical pixels from
         the top left of the screen; -1 (default) puts it near the bottom
         right. floatingOpacity: how visible it is while not in use, in
         percent (default 40, range 15 to 100; it is fully visible under the
         pointer). -->
    <entry name="floatingX" type="Int">
      <default>-1</default>
    </entry>
    <entry name="floatingY" type="Int">
      <default>-1</default>
    </entry>
    <entry name="floatingOpacity" type="Int">
      <default>40</default>
      <min>15</min>
      <max>100</max>
    </entry>
    <!-- Size of the results popup in Plasma grid units. Defaults 30 wide by
         26 tall. Ranges: width 20 to 70, height 12 to 50. -->
    <entry name="popupWidth" type="Int">
      <default>30</default>
      <min>20</min>
      <max>70</max>
    </entry>
    <entry name="popupHeight" type="Int">
      <default>26</default>
      <min>12</min>
      <max>50</max>
    </entry>
    <!-- Live file results while typing (the instant search), shown on the
         Search Bar page. instantSearch: whether to search while typing at all
         (default true; Enter still sends the text to the assistant).
         instantMinChars: characters typed before searching (default 2,
         range 1 to 10). instantDelayMs: pause in typing, in milliseconds,
         before a search is sent (default 200, range 0 to 2000).
         instantResults: matches shown (default 8, range 1 to 20; the daemon
         caps a search at 20). -->
    <entry name="instantSearch" type="Bool">
      <default>true</default>
    </entry>
    <entry name="instantMinChars" type="Int">
      <default>2</default>
      <min>1</min>
      <max>10</max>
    </entry>
    <entry name="instantDelayMs" type="Int">
      <default>200</default>
      <min>0</min>
      <max>2000</max>
    </entry>
    <entry name="instantResults" type="Int">
      <default>8</default>
      <min>1</min>
      <max>20</max>
    </entry>
  </group>
</kcfg>
