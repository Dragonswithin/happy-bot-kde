# Happy Bot application menu entry. A second launch opens the running app.
# The login entry is a copy made from the settings page.
[Desktop Entry]
Type=Application
Name=Happy Bot
GenericName=AI Assistant
Comment=Ask or search anything, about the app you are in
Exec=happy-bot-app
Icon=io.github.dragonswithin.happybot
Terminal=false
Categories=Utility;
Keywords=assistant;ai;chat;search;help;
StartupNotify=false
X-KDE-Shortcuts=
