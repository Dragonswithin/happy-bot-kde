# KRunner DBus plugin entry for Happy Bot, installed by scripts/install.sh
# into ~/.local/share/krunner/dbusplugins/. It tells KRunner to ask the
# assistant's daemon (src/happy_bot/krunner_bridge.py) for matches.
[Desktop Entry]
Name=Happy Bot
Comment=Quick results, your files and questions for Happy Bot
Type=Service
Icon=tools-wizard
X-KDE-ServiceTypes=Plasma/Runner
X-KDE-PluginInfo-Name=happy-bot
X-KDE-PluginInfo-Version=0.1.0
X-KDE-PluginInfo-License=MIT
X-KDE-PluginInfo-EnabledByDefault=true
X-Plasma-API=DBus
X-Plasma-DBusRunner-Service=io.github.dragonswithin.HappyBot.Runner
X-Plasma-DBusRunner-Path=/runner
