# Arch Linux package for KDE AI Assistant, built from this checkout.
#
# Build (from this folder):  makepkg -si
# It installs system-wide what scripts/install.sh installs per user: the
# package in /usr/lib/kde-ai-assistant, the two commands in /usr/bin, the
# daemon as a systemd *user* unit, the panel applet, the KRunner plugin and
# the global-shortcut entry. Each user then runs, once:
#   systemctl --user enable --now kde-ai-assistant-daemon.service
# and adds "AI Assistant" to a panel. Settings stay per user in
# ~/.config/kde-ai-assistant. For publishing to the AUR, replace the local
# source below with a release tarball and its checksum.
pkgname=kde-ai-assistant
pkgver=0.1.0
pkgrel=1
pkgdesc="Panel search bar for KDE Plasma that finds, answers and acts using any AI model you configure"
arch=('any')
license=('MIT')
depends=('python' 'python-gobject' 'plasma-workspace' 'kpackage' 'glib2' 'qt6-declarative')
optdepends=('tesseract: reading text in pictures'
            'imagemagick: picture conversion and edits'
            'ffmpeg: sound and video conversion'
            'poppler: PDF pages and text'
            'kdeconnect: phone tools'
            'qalculate-gtk: unit conversions in the bar (provides qalc)'
            'spectacle: screenshots'
            'lm_sensors: temperatures')
source=()
_root="$(realpath "${startdir}/../..")"

package() {
  install -d "${pkgdir}/usr/lib/kde-ai-assistant"
  cp -r "${_root}/src/kde_ai_assistant" "${pkgdir}/usr/lib/kde-ai-assistant/"
  find "${pkgdir}/usr/lib/kde-ai-assistant" -name '__pycache__' -prune -exec rm -rf {} +
  install -Dm755 "${_root}/launchers/kde-ai-assistant" "${pkgdir}/usr/bin/kde-ai-assistant"
  install -Dm755 "${_root}/launchers/kde-ai-assistant-daemon" "${pkgdir}/usr/bin/kde-ai-assistant-daemon"
  sed 's|^ExecStart=%h/.local/bin/|ExecStart=/usr/bin/|' "${_root}/systemd/user/kde-ai-assistant-daemon.service" \
    | install -Dm644 /dev/stdin "${pkgdir}/usr/lib/systemd/user/kde-ai-assistant-daemon.service"
  install -d "${pkgdir}/usr/share/plasma/plasmoids"
  cp -r "${_root}/plasmoid/io.github.dragonswithin.kdeaiassistant" "${pkgdir}/usr/share/plasma/plasmoids/"
  install -Dm644 "${_root}/krunner/kde-ai-assistant.desktop" "${pkgdir}/usr/share/krunner/dbusplugins/kde-ai-assistant.desktop"
  install -Dm644 "${_root}/desktop/kde-ai-assistant-shortcuts.desktop" \
    "${pkgdir}/usr/share/applications/kde-ai-assistant-shortcuts.desktop"
  install -d "${pkgdir}/usr/share/kglobalaccel"
  ln -s /usr/share/applications/kde-ai-assistant-shortcuts.desktop \
    "${pkgdir}/usr/share/kglobalaccel/kde-ai-assistant-shortcuts.desktop"
  install -Dm644 "${_root}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
