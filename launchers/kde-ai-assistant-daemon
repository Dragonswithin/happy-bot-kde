#!/usr/bin/env python3
"""Launcher installed as ``~/.local/bin/kde-ai-assistant-daemon``. Starts the per-user daemon (the systemd user unit runs this).

The package is not pip-installed; ``scripts/install.sh`` copies it to
``~/.local/lib/kde-ai-assistant`` (override with ``KDE_AI_ASSISTANT_LIB``), and
a system package (``packaging/arch/PKGBUILD``) puts it in
``/usr/lib/kde-ai-assistant``; this file puts the first of those that exists
on the import path, in that order, and calls the entry point. Run from a
checkout, it falls back to the repository's ``src``.
"""

import os
import sys
from pathlib import Path

_candidates = [Path(os.environ["KDE_AI_ASSISTANT_LIB"])] if os.environ.get("KDE_AI_ASSISTANT_LIB") else []
_candidates += [Path.home() / ".local/lib/kde-ai-assistant", Path("/usr/lib/kde-ai-assistant"),
                Path(__file__).resolve().parent.parent / "src"]
sys.path.insert(0, str(next((path for path in _candidates if (path / "kde_ai_assistant").is_dir()), _candidates[-1])))

from kde_ai_assistant.daemon_http import main  # noqa: E402 - path set up above

raise SystemExit(main())
