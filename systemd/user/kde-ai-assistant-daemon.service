[Unit]
Description=KDE AI Assistant desktop daemon
PartOf=plasma-workspace.target
After=plasma-workspace.target
ConditionEnvironment=KDE_FULL_SESSION=true

[Service]
Type=simple
WorkingDirectory=%h
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/.local/bin/kde-ai-assistant-daemon --foreground
Restart=on-failure
RestartSec=3

[Install]
WantedBy=plasma-workspace.target
